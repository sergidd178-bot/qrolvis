# Plantilla de variables de entorno. Este archivo SÍ se versiona.
# Copiar a .env.local y rellenar. Nunca poner valores reales aquí.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salta RLS. Solo en servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dominio con el que se generan los QR. Sin esto no se genera ninguno.
# PROVISIONAL en desarrollo: los QR generados contra una IP local o un dominio
# de Vercel NO se pueden imprimir. Cambiar al dominio definitivo y regenerar.
NEXT_PUBLIC_SITE_URL=

# Envío de las alertas por email. Solo en servidor, nunca con prefijo
# NEXT_PUBLIC_: con esta clave se puede enviar correo en nombre del dominio.
RESEND_API_KEY=

# Remitente de las alertas. Exige tener el dominio verificado en Resend con sus
# registros SPF y DKIM. Sin verificar, Resend solo acepta onboarding@resend.dev,
# que ÚNICAMENTE entrega a la dirección del titular de la cuenta: sirve para
# probar, no para avisar a un negocio.
# Si se deja vacío, se usa "Qrolvis <alertas@qrolvis.com>".
ALERT_FROM_EMAIL=

# Dirección del OPERADOR del servicio, no la de ningún negocio. Recibe el aviso
# cuando un negocio supera 15 alertas en 7 días (docs/05). Sin esto, esa regla
# se queda sin destinatario y no avisa a nadie.
OPERATOR_ALERT_EMAIL=

# Protege /api/cron, que dispara envíos de correo. Lo mandan en
# `Authorization: Bearer` tanto el cron de Vercel como el workflow de GitHub
# Actions. Sin esta variable la ruta responde 503 y no hace nada: falla cerrada,
# para que un despliegue al que se le olvidó no deje el endpoint abierto.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Nombre del operador, tal como debe aparecer FIRMANDO los informes mensuales.
# No es el email de acceso: el informe lo lee un cliente, y "Escrito por
# alguien@gmail.com" no es una firma. Ver docs/05 §3, Bloque 5.
OPERATOR_NAME=
