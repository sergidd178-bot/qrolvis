# Plantilla de variables de entorno. Este archivo SÍ se versiona.
# Copiar a .env.local y rellenar. Nunca poner valores reales aquí.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salta RLS. Solo en servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dominio con el que se generan los QR. Sin esto no se genera ninguno.
# PROVISIONAL en desarrollo: los QR generados contra una IP local o un dominio
# de Vercel NO se pueden imprimir. Cambiar al dominio definitivo y regenerar.
NEXT_PUBLIC_SITE_URL=
